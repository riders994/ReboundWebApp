# systemd unit for the rebound predictor backend (gunicorn).
# Install to /etc/systemd/system/rebound.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now rebound
# Adjust User and paths to match your EC2 setup.
#
# The model bundles are NOT in git. Copy them to models/ before starting:
#   scp FinalModel.pkl MovementModel.pkl <host>:/opt/rebound-app/models/
# The unit refuses to start without the rebounder (REBOUND_REQUIRE_MODEL defaults to
# on) rather than serving 503s that nobody notices. Confirm what is live with:
#   curl -s localhost:8000/healthz

[Unit]
Description=Rebound predictor (gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/rebound-app
Environment="PORT=8000"
# Movement model is optional and fail-soft; set to 0 to serve probabilities only
# and leave every player where he was placed.
Environment="REBOUND_MOVEMENT=1"
ExecStart=/opt/rebound-app/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
