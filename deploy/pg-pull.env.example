# Connection details for deploy/pg-pull.sh — copy this file to pg-pull.env beside the
# script ON THE PI and fill it in. pg-pull.env is gitignored so your host and key path
# never land in the repo.
#
#   cp pg-pull.env.example pg-pull.env

# The EC2 host to pull from — its Elastic IP or a DNS name (required).
PG_PULL_HOST=postuptothe.net

# SSH login user on the box (default: ubuntu). Must be able to read the spool
# directory; DEPLOY.md step 5e adds it to the `backup` group for exactly that.
#PG_PULL_USER=ubuntu

# Path to the SSH private key. Omit to use ssh-agent / ~/.ssh/config — but a timer
# runs without an agent, so for the unattended nightly pull set this explicitly.
#PG_PULL_KEY=/home/pi/.ssh/postup.pem

# Backup spool on the box, written by deploy/pg-backup.sh (default shown).
#PG_PULL_REMOTE=/var/backups/postgres

# Where the archive lives on the Pi (default shown). Put it on real storage, not on
# the SD card the Pi boots from, if you have any.
#PG_PULL_DEST=/srv/backups/postuptothe

# Days of dumps to keep on the Pi. The box only keeps 7 — this is the actual archive.
#PG_PULL_KEEP_DAYS=180

# Fail the run if the newest dump on hand is older than this many days.
#PG_PULL_STALE_DAYS=2
