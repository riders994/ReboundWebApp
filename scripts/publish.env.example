# Connection details for scripts/publish.sh — copy this file to scripts/publish.env
# and fill it in. publish.env is gitignored so your host/key never land in the repo.
#
#   cp scripts/publish.env.example scripts/publish.env

# The EC2 host to publish to — its Elastic IP or a DNS name (required).
PUBLISH_HOST=postuptothe.net

# SSH login user on the box (default: ubuntu).
#PUBLISH_USER=ubuntu

# Path to your SSH private key (.pem). Omit to use ssh-agent / ~/.ssh/config.
#PUBLISH_KEY=~/.ssh/postup.pem

# Live web root on the box (default: /var/www/site).
#PUBLISH_REMOTE=/var/www/site

# Owner:group the published files should have on the box (default: www-data:www-data).
#PUBLISH_OWNER=www-data:www-data
